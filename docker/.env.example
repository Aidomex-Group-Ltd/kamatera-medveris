# Medveris supporting services — Compose environment template
# Place the real file at: /opt/medveris/compose/.env (VPS only)
# Do not commit the real .env. This template is safe to ship in the repo.
#
# Secrets MUST be generated on the VPS with a secure random source, not edited
# by hand and not copied from this file. See docs/DOCKER_DEPLOYMENT.md.
#
# Permissions on the real .env:
#   chmod 600 /opt/medveris/compose/.env
#   chown deploy:deploy /opt/medveris/compose/.env   # or the deployment owner

# ---------------------------------------------------------------------------
# n8n dedicated PostgreSQL (private Docker container, NOT the native PG 18.6)
# ---------------------------------------------------------------------------
# Use a strong random password. Example generation on the VPS:
#   N8N_DB_PASSWORD="$(openssl rand -base64 24)"
#   printf 'N8N_DB_PASSWORD=%s\n' "$N8N_DB_PASSWORD" >> .env
# Do not reuse Medveris production DB credentials here.

N8N_DB_USER=n8n
N8N_DB_PASSWORD=
N8N_DB_NAME=n8n

# ---------------------------------------------------------------------------
# n8n encryption key (required for credentials encryption at rest)
# ---------------------------------------------------------------------------
# Generate once and store securely. Example generation on the VPS:
#   N8N_ENCRYPTION_KEY="$(openssl rand -base64 32)"
#   printf 'N8N_ENCRYPTION_KEY=%s\n' "$N8N_ENCRYPTION_KEY" >> .env
# Losing this key means n8n credential encryption cannot be recovered.
# Do not rotate arbitrarily; treat it as a persistent secret.

N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# n8n application settings (can be defaults; non-secret)
# ---------------------------------------------------------------------------
# Internal hostname used by the container. Does not imply public exposure.
N8N_HOST=n8n.internal

# Protocol/host used for webhook URLs and self-referential links.
# Update before any public exposure; must remain private during initial deploy.
N8N_PROTOCOL=http
WEBHOOK_URL=http://n8n.internal:5678

# Timezone for n8n schedules and executions.
GENERIC_TIMEZONE=UTC
