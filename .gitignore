# Dependencies
node_modules/
pnpm-lockfile*

# Environment variables
# The repo may contain templates such as docker/.env.example.
# Runtime env files stay out of Git.
.env
.env.*
*.env
!docker/.env.example
!ansible.cfg

# Terraform state
*.tfstate
*.tfstate.*
terraform.tfvars
.terraform/
.terraform.lock.hcl

# Ansible
ansible-navigator

# Helm
charts/*.tgz

# Kubernetes
.kube/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
.wrangler/

# Medveris supporting-services deployment (VPS only)
# Deployment target and runtime env are not part of the repository.
/opt/medveris/
compose.env

# Runtime per-service env files stay out of Git.
# The repo may still contain templates such as docker/.env.example.
compose/.env
docker/.env

# Runner credentials are host-local and must never be committed.
actions-runner/.credentials
actions-runner/.credentials_rsaparams
actions-runner/.runner
